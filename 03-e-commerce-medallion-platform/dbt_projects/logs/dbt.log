[0m12:58:02.137890 [debug] [Thread-4 (]: On model.medallion_platform.silver_geolocation: /* {"app": "dbt", "dbt_version": "1.12.3", "dbt_databricks_version": "1.12.5", "databricks_sql_connector_version": "4.4.0", "profile_name": "medallion_platform", "target_name": "dev", "invocation_id": "1124a37a-3d2d-4393-b8fb-a87d2f304018", "node_id": "model.medallion_platform.silver_geolocation"} */

  
    
        create or replace table `dbt-medallion`.`silver`.`silver_geolocation`
      
      
    using delta
  
      
      
      
      
      
      
      
      
      as
      -- Fixes the 26.2% duplicate-row problem found in raw geolocation data: collapses to one
-- representative lat/long per zip code prefix instead of joining against duplicated rows.
select
    geolocation_zip_code_prefix as customer_zip_code_prefix,
    avg(geolocation_lat) as avg_lat,
    avg(geolocation_lng) as avg_lng,
    first(geolocation_city) as city,
    first(geolocation_state) as state
from `dbt-medallion`.`bronze`.`olist_geolocation_dataset`
group by geolocation_zip_code_prefix
  
