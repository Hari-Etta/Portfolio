# Copy to .env for local development. Never commit .env.

# ── LLM (Anthropic) ────────────────────────────────────────
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-5-5
# Optional fallback provider: LLM_PROVIDER=openai + OPENAI_API_KEY / OPENAI_CHAT_MODEL

# ── Embeddings (Google Gemini free tier) ───────────────────
GEMINI_API_KEY=...
GEMINI_EMBED_MODEL=gemini-embedding-2
EMBED_DIM=768

# ── Postgres with pgvector ─────────────────────────────────
# Neon:  postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Local: docker compose up -d   then use the line below
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/iit_chatbot
AUTO_INGEST=true

# ── Feature flags ──────────────────────────────────────────
USE_LLM_INTENT=true
USE_LLM_SLOTS=true
USE_LLM_NARRATION=true
USE_LLM_ANSWER_SYNTHESIS=true

# ── API guards (leave PROXY_SECRET / ADMIN_TOKEN empty locally) ──
ALLOWED_ORIGINS=http://localhost:3000
PROXY_SECRET=
ADMIN_TOKEN=
RATE_LIMIT_PER_HOUR=30
DAILY_MESSAGE_CAP=300
