# Python
venv/
__pycache__/
*.pyc

# Secrets: never committed
.env
.env.*
!.env.example

# Data: lives in S3 only, never in git
**/*.parquet
**/*.csv
.pybaseball/
athena-results/

# dbt build artifacts (Phase 2)
**/target/
**/dbt_packages/
**/logs/
**/.user.yml

