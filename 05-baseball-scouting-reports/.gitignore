**/.terraform/
**/*.tfstate
**/*.tfstate.*
**/*.tfvars
!**/*.tfvars.example

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
# DuckDB database files (dbt working db)
**/*.duckdb
**/*.duckdb.wal

# Model artifacts (stored in S3, not git)
artifacts/
